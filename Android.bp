package {
    default_applicable_licenses: ["external_inih_license"],
}

license {
    name: "external_inih_license",
    license_kinds: ["SPDX-license-identifier-BSD-3-Clause"],
    license_text: ["LICENSE.txt"],
}

cc_library_shared {
    name: "libinih",
    srcs: ["ini.c"],
    export_include_dirs: ["."],
}

cc_library_shared {
    name: "libinih-cpp",
    srcs: ["cpp/INIReader.cpp"],
    export_include_dirs: [".", "cpp"],
    shared_libs: ["libinih"],
}

cc_library_headers {
    name: "inih_headers",
    export_include_dirs: ["."],
}

cc_library_headers {
    name: "libinih-cpp_headers",
    export_include_dirs: [".", "cpp"],
}